[Unit]
Description=Viva Faka production data backup
Documentation=file:///usr/local/bin/faka-backup.sh
ConditionPathExists=/srv/faka/data/db/dujiao.db

[Service]
Type=oneshot
ExecStart=/usr/local/bin/faka-backup.sh
User=root
Group=root
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
